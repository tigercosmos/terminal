{
  "permissions": {
    "allow": [
      "Shell(make)",
      "Shell(make:build*)",
      "Shell(make:run*)",
      "Shell(make:test*)",
      "Shell(make:lint*)",
      "Shell(make:fmt*)",
      "Shell(make:deps*)",
      "Shell(make:web*)",
      "Shell(make:clean*)",
      "Shell(xcodebuild)",
      "Shell(xcrun)",
      "Shell(swift)",
      "Shell(cargo:test*)",
      "Shell(cargo:build*)",
      "Shell(cargo:check*)",
      "Shell(cargo:clippy*)",
      "Shell(cargo:fmt*)",
      "Shell(rustfmt)",
      "Shell(bun:install*)",
      "Shell(bun:run*)",
      "Shell(ls)",
      "Shell(file)",
      "Shell(wc)",
      "Shell(find)",
      "Shell(grep)",
      "Shell(rg)",
      "Shell(tree)",
      "Shell(jq)",
      "Shell(plutil)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:branch*)",
      "Shell(git:remote*)",
      "Shell(git:stash*)",
      "Shell(git:ls-files*)",
      "Shell(git:rev-parse*)",
      "Shell(git:submodule*)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:restore*)",
      "Shell(gh:pr*)",
      "Shell(gh:issue*)",
      "Shell(gh:run*)",
      "Read(**/*)",
      "Write(**/*)",
      "Glob(**/*)",
      "Grep(**/*)",
      "Delete(**/*)",
      "Task(**/*)",
      "WebSearch(**/*)",
      "WebFetch(**/*)"
    ],
    "deny": [
      "Shell(rm:*)",
      "Shell(sudo:*)",
      "Read(.env*)",
      "Write(**/.env*)",
      "Read(Config/Local.xcconfig)"
    ]
  }
}
