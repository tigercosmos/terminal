    "NSDesktopFolderUsageDescription": {
      "comment": "Privacy prompt shown when a program running in a Terminal terminal reads the user's Desktop folder.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Terminal would like to access files in your Desktop folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal内で実行中のプログラムがデスクトップフォルダ内のファイルにアクセスしようとしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Terminal 中运行的程序请求访问你的“桌面”文件夹中的文件。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "comment": "Privacy prompt shown when a program running in a Terminal terminal reads the user's Downloads folder.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Terminal would like to access files in your Downloads folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal内で実行中のプログラムがダウンロードフォルダ内のファイルにアクセスしようとしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Terminal 中运行的程序请求访问你的“下载”文件夹中的文件。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy prompt shown when a program running in a Terminal terminal requests microphone access.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Terminal would like to use your microphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal内で実行中のプログラムがマイクを使用しようとしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Terminal 中运行的程序请求使用你的麦克风。"
          }
        }
      }
    }
  },
