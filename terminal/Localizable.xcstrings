    "\nRestart running agents to load the skill." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n実行中のエージェントを再起動してスキルを読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n请重启正在运行的代理以加载该技能。"
          }
        }
      }
    },
    "\nRestart running agents to refresh their available skills." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n実行中のエージェントを再起動して、使えるスキルを更新してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n请重启正在运行的代理以刷新其可用技能。"
          }
        }
      }
    },
