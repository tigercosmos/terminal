      }
    },
    "Stops Terminal's own file, Git, and search panels from reading Desktop, Documents, Downloads, your media folders, iCloud Drive, and mounted volumes — so macOS never asks on their behalf. Commands you run in a terminal are unaffected: macOS asks about those itself." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal自身のファイル、Git、検索の各パネルが、デスクトップ、書類、ダウンロード、メディアフォルダ、iCloud Drive、マウント済みボリュームを読み取らないようにします。これらのパネルのためにmacOSがアクセスを求めることはなくなります。ターミナルで実行したコマンドには影響しません——それについてはmacOS自身が確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阻止 Terminal 自身的文件、Git 和搜索面板读取桌面、文稿、下载、媒体文件夹、iCloud 云盘以及已挂载的宗卷，因此 macOS 不会再为这些面板请求访问权限。你在终端中运行的命令不受影响——macOS 会自行询问那些命令。"
          }
        }
      }
    },
    "Switch Branch" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
