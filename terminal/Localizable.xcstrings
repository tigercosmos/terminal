    "Text Editing" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト編集"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本编辑"
          }
        }
      }
    },
    "%@ couldn’t say which directory this terminal is in — a shell inside screen or tmux can’t be followed — so Terminal looked in %@, where an ssh command lands. Open the repository’s directory in a new terminal to work on it here." : {
      "comment" : "Git panel empty state on a remote host whose working directory could not be established. The first placeholder is a hostname, the second the directory that was searched.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はこのターミナルがどのディレクトリにいるかを答えられませんでした（screen や tmux の中のシェルは追跡できません）。そのため Terminal は ssh の接続先である %@ を調べました。ここで作業するには、リポジトリのディレクトリで新しいターミナルを開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法确定此终端所在的目录（screen 或 tmux 中的 shell 无法跟随），因此 Terminal 查看了 ssh 登录所在的 %@。若要在此处进行操作，请在仓库目录中打开一个新终端。"
          }
        }
      }
    },
    "%@ is not in a repository." : {
      "comment" : "Git panel empty state for a remote directory outside any repository. The placeholder is a host-qualified path.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はリポジトリ内にありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在仓库中。"
          }
        }
      }
    },
    "The working tree on %@ — read-only" : {
      "comment" : "Compare header for a working tree on a remote host. The placeholder is a hostname.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上のワーキングツリー — 読み取り専用"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上的工作树 — 只读"
          }
        }
      }
    },
    "The webpage stopped responding." : {
      "localizations" : {
